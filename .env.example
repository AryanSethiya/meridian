# Anthropic API key — required for live process/eval (not for --dry-run).
# Do not commit a real key. Prefer a local .env (gitignored) or shell export.
#
# Option A — shell (takes precedence if both are set):
#   export ANTHROPIC_API_KEY=sk-ant-...
#
# Option B — this file / copy to .env:
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override estimated Anthropic USD per million tokens (defaults ≈ Sonnet list).
# MERIDIAN_PRICE_INPUT_PER_MTOK=3.0
# MERIDIAN_PRICE_OUTPUT_PER_MTOK=15.0

# Optional: allow POD image vision (off by default — pixels cannot be redacted).
# MERIDIAN_ALLOW_POD_VISION=0
